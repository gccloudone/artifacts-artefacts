FROM artifacts-artefacts.devops.cloud-nuage.canada.ca/docker-chainguard-remote/ssc-spc.gc.ca/jre@sha256:af0d48bc440739d8f616fb06a55a3cd4e983ce24dbfebb1400a2887207854725
