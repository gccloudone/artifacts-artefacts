RUN javac *.java

FROM artifacts-artefacts.devops.cloud-nuage.canada.ca/docker-chainguard-remote/ssc-spc.gc.ca/jre@sha256:b49a90e0d194ce4d75c2e21929fe19037407791640faf7ac38bdd15a641f0d25
WORKDIR /app
